# Copy to .env and fill in. Never commit a real .env or a real key.

# HTTP port (default 3000)
PORT=3000

# Production domain & reverse proxy settings (for Caddy in docker-compose.prod.yml)
DOMAIN=localhost
LETSENCRYPT_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Persistent SQLite file (default ./data/mcp_rooms.db)
DATABASE_PATH=./data/mcp_rooms.db

# Google Gemini key for /api/chat. Leave empty to run in degraded
# (rule-based) mode with no model calls. Negotiation is always a demo script.
# API_KEY is accepted as a fallback for the same value.
GEMINI_API_KEY=

# Model ID for /api/chat, e.g. a model id from the Google AI docs.
GEMINI_MODEL=

# OpenRouter configuration (Universal LLM gateway supporting DeepSeek, Claude, Llama, Gemini, etc.)
# If set, server-side /api/chat uses OpenRouter when client does not supply a personal key.
# Recommended free models: deepseek/deepseek-chat:free, meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free

# Embeddings: disabled | google. "disabled" uses the lexical fallback only.
EMBEDDING_PROVIDER=disabled
EMBEDDING_MODEL=text-embedding-004

# Demo data: 0 = start with an empty catalogue (default).
# 1 = seed the fictional listings and profiles (or run `npm run seed:demo`).
DEMO_SEED=0

# Browser origins allowed to call the API, comma-separated.
# Empty = same-origin only. Do not use "*" on a public deployment.
CORS_ALLOWED_ORIGINS=

# Per-minute request limits (per principal, or per socket address without a key).
# Counters live in one process: a restart or a second instance starts from zero.
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_NEGOTIATE_PER_MINUTE=30
RATE_LIMIT_LISTINGS_PER_MINUTE=30
RATE_LIMIT_MESSAGES_PER_MINUTE=120
RATE_LIMIT_MATCH_PER_MINUTE=60
RATE_LIMIT_MCP_PER_MINUTE=240
