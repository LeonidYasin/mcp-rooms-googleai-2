# Caddy Production Reverse Proxy Configuration for MCP Rooms Marketplace
# Handles Automatic HTTPS/TLS, SSE Stream Header Preservation, Compression & Rate Limit Pass-Through

{
	email {$LETSENCRYPT_EMAIL:admin@example.com}
	admin off
}

{$DOMAIN:localhost} {
	# Encoding compression for static SPA and JSON API
	encode zstd gzip

	# Security Headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	# Disable buffering for Server-Sent Events (SSE) streaming endpoints
	@sse path /api/rooms/*/stream
	handle @sse {
		reverse_proxy mcp-rooms:3000 {
			flush_interval -1
		}
	}

	# Reverse proxy all standard API and static app traffic
	handle {
		reverse_proxy mcp-rooms:3000
	}
}
